{
  "name": "goks-gox",
  "displayName": "GoKS GOX Language Support",
  "description": "Language support, syntax highlighting, and LSP integration for GoKS (.gox) files",
  "version": "0.2.4",
  "publisher": "misbakhul29",
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/misbakhul29/goks"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:gox"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gox",
        "aliases": [
          "GoKS GOX",
          "gox"
        ],
        "extensions": [
          ".gox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gox",
        "scopeName": "source.gox",
        "path": "./syntaxes/gox.tmLanguage.json"
      },
      {
        "scopeName": "gox.injection",
        "path": "./syntaxes/gox.injection.tmLanguage.json",
        "injectTo": [
          "source.gox"
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}